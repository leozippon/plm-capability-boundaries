*.fasta.gz
*.fastq.gz
*.fa.gz
*.fq.gz

# Editor and system noise
.DS_Store
Thumbs.db
*.swp
*.swo
*~

# Retired working-tree names, kept so that they are not resurrected by an add.
Research1/
