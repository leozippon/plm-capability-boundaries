# Copy this file to .env.local and fill the values for this machine.
# .env.local is not distributed. A variable already exported in the shell is
# left unchanged. An unset or empty path variable keeps the default in the code
# that reads it, mostly a location under data/ or external/ in the checkout.

# Used by the hf CLI when staging checkpoints, not by any Python code here.
# Export them before running hf (set -a; . .env.local; set +a) and delete the
# HF_ENDPOINT line if no mirror is used.
HF_ENDPOINT=
HF_TOKEN=

# Locations read by src/capability/core/arms.py.
REPO_ROOT=
MODEL_BASE_DIR=
MODEL_ROOT=
TEXT_MODEL_BASE_DIR=
TEXT_MODEL_DIR=
OPENWEBTEXT_DIR=
SWISSPROT_FASTA=
ZYMCTRL_FASTA=
UNIREF50_FASTA=
PROGEN3_DIR=

# Dataset and reference locations read by the module or entry point that uses
# them.
# ProteinGym substitution assays (directory).
TRANSFER_PROTEINGYM_DIR=
# Pfam per-residue annotation table (TSV).
TRANSFER_PFAM_RESIDUE_TSV=
# InterPro protein2ipr table (dat.gz).
TRANSFER_PROTEIN2IPR=
# CATH superfamily assignments (TSV).
TRANSFER_CATH_SUPERFAMILY_TSV=
# InterPro entry database (interpro.xml.gz).
TRANSFER_INTERPRO_XML=
# UniProt Swiss-Prot XML (xml.gz).
TRANSFER_SWISSPROT_XML=
# ProLLaMA superfamily list (txt).
TRANSFER_PROLLAMA_SUPERFAMILIES=
# Tsuboyama 2023 MegaScale stability data (directory).
TRANSFER_MEGASCALE_DIR=
# MegaScale design/natural disjointness certificate (directory), read by the designed-referent stage.
TRANSFER_MEGASCALE_CERTIFICATE_DIR=
# Record-local UniRef50 k-mer background (directory), read by the designed-referent stage.
TRANSFER_KMER_BACKGROUND_DIR=
# Retrieval-bound output (directory) supplying the corpus residue background to the designed-referent stage.
TRANSFER_RETRIEVAL_BOUND_DIR=
# AlphaFold structure files used as generation structure inputs (directory).
TRANSFER_ALPHAFOLD_DIR=

# DIAMOND search used by the retrieval-bound and remoteness stages.
# Reference index over UniRef50 (.dmnd).
TRANSFER_DIAMOND_DB=
# Unpacked DIAMOND release (directory).
TRANSFER_DIAMOND_DIR=
# Scratch directory for DIAMOND temporary files.
TRANSFER_DIAMOND_TMPDIR=
# DIAMOND release tarball and its SHA-256 file.
TRANSFER_DIAMOND_TARBALL=
TRANSFER_DIAMOND_CHECKSUM=

# Read from the process environment only, never from .env.local: export it in
# the shell. Root of the patched progen3 Python package (its src directory).
# TRANSFER_PROGEN3_SRC=
